   "source": [
    "# Task-7.3\n",
    "# Inheritance(Single level)
    "# firstly , creating the main Product class "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "class Product:\n",
    "    def __init__(self,name,price):\n",
    "        self.name=name\n",
    "        self.price=price\n",
    "    \n",
    "    def get_info(self):\n",
    "        print(f\"The product {self.name} is of {self.price} Rs.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Creating a Subclass Electroniproduct that inherites from Product.\n",
    "# Additional Attribute: Warranty_years.\n",
    "# Overriding the get_info() mathod to inclue the warranty info."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ElectronicProduct(Product):\n",
    "    def __init__(self,name,price,warranty_years):\n",
    "        super().__init__(name,price)\n",
    "        self.warranty_years = warranty_years\n",
    "\n",
    "    def get_info(self):\n",
    "        base_info= super().get_info()\n",
    "        return f\"{base_info}, Warranty:{self.warranty_years} years.\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Creating an object and demonstrating Inheritance and Overriding."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The product Smart Tv is of 55000 Rs.\n",
      "None, Warranty:2 years.\n"
     ]
    }
   ],
   "source": [
    "tv = ElectronicProduct(\"Smart Tv\",55000,2)\n",
    "print(tv.get_info())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Task Completed!!!"
   ]
  }
